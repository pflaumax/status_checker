TELEGRAM_BOT_TOKEN='from telegram @BotFather'
TELEGRAM_CHAT_ID=123456789
WEBSITE_URL=https://pflaumax.dev
LAN_IP=192.168.1.100
TEMP_THRESHOLD=85.0
# Alert when the fan reads 0 RPM at or above this CPU temperature (kernel starts it at 50).
FAN_ALERT_TEMP=50
LOAD_THRESHOLD=4.0
DISK_THRESHOLD=90.0
# Root filesystem on the SD card; its ext4 error flag is checked every pass.
ROOTFS_DEVICE=/dev/disk/by-partuuid/YOUR-ROOT-PARTUUID
# Written weekly by reiberry-rbi-backup/scripts/integrity-check.sh (dpkg -V).
INTEGRITY_STATE=/var/lib/integrity-check/last.json
INTEGRITY_MAX_DAYS=10
# Written by reiberry-rbi-backup/scripts/weekly-clone.sh after each good clone.
# Empty disables the /system line and the reminder once it is older than MAX_DAYS.
USB_CLONE_STAMP=/var/lib/usb-clone/last-ok
USB_CLONE_MAX_DAYS=30
# Checkouts under this directory are compared with GitHub (uncommitted files,
# commits not pushed or not pulled). Empty disables the /system line and the alert.
GIT_REPOS_DIR=/home/reiberry/personal
# repo/path pairs that differ from git on purpose, comma-separated. The funko-bot
# unit in git is a template with placeholder paths; the Pi copy has the real ones.
GIT_DRIFT_IGNORE=funko-bot/funko-bot.service
# Nightly dump directories as name=path pairs, comma-separated. Alerts when the
# newest file in any of them is older than DUMP_MAX_HOURS. Empty disables it.
DUMP_DIRS=site=/home/reiberry/site_backups,joplin=/mnt/hdd/joplin/dumps,sprout=/home/reiberry/sprout_backups
DUMP_MAX_HOURS=26
# Written nightly by reiberry-rbi-backup/scripts/restic-backup.sh. Set it only
# once the off-site backup is configured; empty disables the line and the alert.
RESTIC_STATE=
RESTIC_MAX_HOURS=26
# Dead man's switch (e.g. a Healthchecks.io ping URL), requested at the end of
# every cron pass. Set the check's period to 30 min. Empty disables it.
HEARTBEAT_URL=
# Empty disables the Joplin Server check
JOPLIN_URL=https://joplin.pflaumax.dev
PIHOLE_URL=http://localhost:8080
PIHOLE_PASSWORD=
# LAN devices that should query Pi-hole at least once a day, as alias=MAC pairs
# (comma-separated), e.g. vacuum=00:aa:bb:cc:dd:ee. Alerts when one has been
# silent for WATCH_SILENT_HOURS. Needs PIHOLE_PASSWORD; empty disables it.
WATCH_DEVICES=
WATCH_SILENT_HOURS=30
# Use a stable /dev/disk/by-id/ path: sda/sdb swap between boots and when USB disks
# are added or removed. Find it with: ls -l /dev/disk/by-id/ | grep -v part
SMART_DEVICE=/dev/disk/by-id/usb-YOUR_DRIVE-0:0
